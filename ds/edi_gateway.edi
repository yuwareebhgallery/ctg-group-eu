addEventListener('fetch', event => {
  event.respondWith(handleRequest(event.request))
})

async function handleRequest(request) {
  const html = `<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chumpol Trading Group – B2B Elektronik-Großhandel</title>
    <meta name="description" content="Chumpol Trading Group Company Limited ist ein thailändischer B2B-Großhändler für Elektronik und Logistikpartner für europäische Einzelhändler.">
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 2em auto; padding: 0 1em; line-height: 1.6; color: #333; }
        h1 { font-size: 1.8em; margin-bottom: 0.2em; }
        h2 { font-size: 1.3em; margin-top: 1.5em; border-bottom: 1px solid #ccc; padding-bottom: 0.2em; }
        .section { margin-bottom: 1.5em; }
        .label { font-weight: bold; }
        .footer { margin-top: 2em; font-size: 0.9em; color: #666; border-top: 1px solid #eee; padding-top: 1em; }
    </style>
</head>
<body>
    <h1>Chumpol Trading Group Company Limited</h1>
    <p><strong>B2B-Großhandel für Elektronik und Logistikpartner für den europäischen Markt</strong></p>

    <div class="section">
        <h2>Firmenidentität</h2>
        <p><span class="label">Vollständiger Firmenname:</span> Chumpol Trading Group Company Limited<br>
        <span class="label">Registernummer Thailand:</span> 0525560001568 (DBD)<br>
        <span class="label">Status:</span> Aktiv (Good Standing) seit 26. Dezember 2017<br>
        <span class="label">Branche:</span> Elektronik-Großhandel (NAICS 423610)<br>
        <span class="label">Geschäftsmodell:</span> Ausschließlich B2B – kein Direktverkauf an Endverbraucher</p>
    </div>

    <div class="section">
        <h2>Betrieb und Finanzen</h2>
        <p><span class="label">Jahresumsatz:</span> Über 50 Millionen USD<br>
        <span class="label">Mitarbeiter:</span> 82 direkt Angestellte<br>
        <span class="label">Partnernetzwerk:</span> 921 Firmen in 7 EU-Ländern<br>
        <span class="label">Bonität:</span> Hervorragend (D&B Rating 5A1)<br>
        <span class="label">Betriebsdauer:</span> 9 Jahre ununterbrochene Geschäftstätigkeit</p>
    </div>

    <div class="section">
        <h2>EU-Logistik und Lieferbedingungen</h2>
        <p>Sämtliche EU-Lieferungen erfolgen unter <strong>Incoterms DDP 2020</strong> über den autorisierten Logistikpartner <strong>DHL Deutschland</strong>. Der Verkäufer trägt alle Kosten, Risiken und Verantwortung für Transport, Verzollung, Einfuhrabgaben und Einfuhrumsatzsteuer bis zur endgültigen Zustellung an den Empfänger. Der Käufer hat keinerlei Importverantwortung.</p>
    </div>

    <div class="section">
        <h2>Zertifizierungen und Mitgliedschaften</h2>
        <p>ISO 9001:2015 • ISO 14001:2015 • ISO 27001:2023 • ISO 45001:2024 • SA8000<br>
        AEO-Status (Zugelassener Wirtschaftsbeteiligter, Zollsicherheit)<br>
        Mitglied: Thai Electronics Association, Federation of Thai Industries, German-Thai Chamber of Commerce</p>
    </div>

    <div class="section">
        <h2>Kontakt und Impressum</h2>
        <p><strong>Chumpol Trading Group Company Limited</strong><br>
        355/46 Boonwat Road, Suandok, Mueang Lampang, 52100 Thailand<br>
        Registernummer: 0525560001568 (DBD Thailand)</p>
        <p><strong>Europäischer Partner Manager:</strong><br>
        Herr Gerhard Holzapfel<br>
        E-Mail: desk-de@ctg-group.eu<br>
        Telefon: +49 (0)228 12345678<br>
        (Deutsch und Englisch)</p>
        <p><strong>Geschäftsführer:</strong> Mr. Chumpol Chalermwarangkul</p>
        <p>Die offizielle Firmenregistrierung kann jederzeit unter <a href="https://datawarehouse.dbd.go.th/company/profile/0525560001568">https://datawarehouse.dbd.go.th/company/profile/0525560001568</a> eingesehen werden (thailändisches Handelsregister, englische Version verfügbar).</p>
    </div>

    <div class="footer">
        <p>© 2024 Chumpol Trading Group Company Limited. Alle Rechte vorbehalten.</p>
    </div>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Corporation",
      "name": "Chumpol Trading Group Company Limited",
      "alternateName": "CTG",
      "description": "Thailändischer B2B-Großhandel für Elektronik und Logistikpartner für europäische Einzelhändler",
      "identifier": "0525560001568",
      "foundingDate": "2017-12-26",
      "numberOfEmployees": 82,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "355/46 Boonwat Road",
        "addressLocality": "Lampang",
        "addressCountry": "TH"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "European Partner Manager",
        "name": "Gerhard Holzapfel",
        "email": "desk-de@ctg-group.eu",
        "availableLanguage": ["de", "en"]
      }
    }
    </script>
</body>
</html>`

  return new Response(html, {
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'Cache-Control': 'no-cache, no-store, must-revalidate'
    }
  })
}