    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Courier New', 'Segoe UI', monospace;
            max-width: 900px;
            margin: 30px auto;
            padding: 25px;
            background: #0d1117;
            color: #e6edf3;
            line-height: 1.6;
        }
        .header {
            border-bottom: 2px solid #58a6ff;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .header h1 { color: #58a6ff; font-size: 1.4em; }
        .header p { color: #8b949e; font-size: 0.9em; }
        .section {
            background: #161b22;
            padding: 18px 22px;
            border-radius: 8px;
            margin: 12px 0;
            border-left: 4px solid #58a6ff;
        }
        .section-red { border-left-color: #f85149; }
        .section-green { border-left-color: #3fb950; }
        .section-yellow { border-left-color: #d29922; }
        .section-purple { border-left-color: #bc8cff; }
        .field {
            display: flex;
            padding: 4px 0;
            border-bottom: 1px solid #21262d;
        }
        .field-key {
            color: #58a6ff;
            font-weight: bold;
            width: 220px;
            flex-shrink: 0;
        }
        .field-value {
            color: #f0f6fc;
            word-break: break-word;
        }
        .field-value.green { color: #3fb950; }
        .field-value.red { color: #f85149; }
        .field-value.yellow { color: #d29922; }
        .note {
            background: #0d1117;
            padding: 12px 15px;
            border-radius: 6px;
            margin: 10px 0;
            font-size: 0.9em;
            color: #8b949e;
            border: 1px solid #21262d;
        }
        .note strong { color: #f0f6fc; }
        .separator { border-top: 1px solid #21262d; margin: 20px 0; }
        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #21262d;
            font-size: 0.8em;
            color: #8b949e;
            text-align: center;
        }
        .badge {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 20px;
            font-size: 0.75em;
            font-weight: bold;
        }
        .badge-green { background: #238636; color: white; }
        .badge-yellow { background: #9e6a03; color: white; }
        .badge-red { background: #da3633; color: white; }
        a { color: #58a6ff; text-decoration: none; }
        a:hover { text-decoration: underline; }
        @media (max-width: 700px) {
            body { padding: 15px; }
            .field { flex-direction: column; padding: 8px 0; }
            .field-key { width: 100%; }
        }
    </style>
</head>
