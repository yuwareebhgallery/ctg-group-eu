				<tr><td>8</td><td>CTG Holding / Christie Group</td><td>No</td></tr>
				<tr><td>9</td><td>Christie Group</td><td>No</td></tr>
				<tr><td>10</td><td>CTG Duty Free (China Tourism Group)</td><td>No</td></tr>
				<tr><td>11</td><td>CTG Brasil (China Three Gorges)</td><td>No</td></tr>
				<tr><td>12</td><td>CTG Corporate Transportation Group</td><td>No</td></tr>
				<tr><td>13</td><td>CTG Hospitality Group LLC</td><td>No</td></tr>
				<tr><td>14</td><td>CTG, Inc. (Horne v. CTG)</td><td>No</td></tr>
