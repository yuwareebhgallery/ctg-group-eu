<script type="application/json" id="cookiesAndConsent-embedded" data-origin-file="cookiesAndConsent.json" data-origin-url="https://ctg-group.eu/cookiesAndConsent.json">
{
	"@type":"PropertyValue",
	"name":"Cookie policy and consent management",
	"legalBasis":"Section 25 TTDSG (German Telecommunications Telemedia Data Protection Act) / Art. 6(1)(b) and (f) GDPR",
	"explanation":"Our website uses only technically necessary cookies. These cookies are essential for the basic functionality of the website (e.g. session management, load balancing, security). They do not require your consent under Section 25(2) TTDSG and are processed on the legal basis of Art. 6(1)(b) (contract performance) or Art. 6(1)(f) (legitimate interest in a functional website).",
	"noTrackingCookies":"We do not use any marketing, tracking, analytics, or third‑party cookies. No personal data is transferred to advertising networks or analytics providers.",
	"noConsentRequired":"Because we use no non‑essential cookies, no cookie consent banner is displayed. If we ever introduce optional cookies in the future, we will obtain your explicit consent beforehand (Art. 6(1)(a) GDPR and Section 25(1) TTDSG).",
	"storagePeriod":"Technically necessary cookies are stored only for the duration of your session or up to a maximum of 30 days, unless a longer period is technically required (e.g. for language preferences).",
	"userControl":"You can delete or block cookies at any time through your browser settings. However, disabling essential cookies may impair the functionality of the website."
}
</script>

