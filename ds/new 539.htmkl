<style>
	*{margin:0;padding:0;box-sizing:border-box;}
	body{background:#f4f7f5;font-family:'Segoe UI',Roboto,system-ui,sans-serif;line-height:1.5;padding:2rem 1rem;color:#1a2e2a;}
	.container{max-width:1400px;margin:0 auto;background:#fff;border-radius:28px;box-shadow:0 12px 30px rgba(0,0,0,0.08);overflow-x:auto;}
	header{background:#0f2c2f;color:#fff;padding:2rem;}
	header h1{font-size:1.8rem;margin-bottom:0.5rem;}
	.content{padding:2rem;}
	h2{font-size:1.6rem;color:#0f2c2f;border-left:5px solid #2c6e6f;padding-left:1rem;margin:1.8rem 0 1rem 0;}
	h3{font-size:1.2rem;color:#1e4a4d;margin:1.2rem 0 0.6rem;}
	table{width:100%;border-collapse:collapse;margin:1rem 0 1.5rem;background:#fff;font-size:0.85rem;}
	th,td{border:1px solid #cbdcd9;padding:0.7rem;text-align:left;vertical-align:top;}
	th{background:#e9f0ed;font-weight:600;position:sticky;top:0;}
	.disambiguation-table td:first-child{font-family:monospace;background:#fef7e0;width:60px;}
	.info-box{background:#f0f4f2;padding:1rem;border-radius:16px;margin:1rem 0;font-size:0.9rem;}
	.legal{font-size:0.75rem;border-top:1px solid #cbdcd9;padding-top:1rem;margin-top:2rem;color:#4a5b56;}
	.ki-box{background:#faf6e9;border-left:5px solid #b45309;padding:1.2rem;margin:1.5rem 0;border-radius:12px;}
	@media(max-width:700px){.content{padding:1rem;}th,td{padding:0.5rem;}}
	.docs-section{max-width:1200px;margin:2rem auto;background:#fff;border-radius:1rem;box-shadow:0 1px 2px rgba(0,0,0,0.04),0 1px 4px rgba(0,0,0,0.02);font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1e2f3e;}
	.docs-header{padding:1.25rem 1.5rem 0.5rem 1.5rem;border-bottom:1px solid #eef2f5;}
	.docs-header h3{font-size:1.35rem;font-weight:500;margin:0;color:#2c4c6c;display:flex;align-items:center;gap:0.5rem;}
	.docs-header h3 span{font-size:1.4rem;}
	.docs-sub{font-size:0.8rem;color:#5e7e9c;margin-top:0.25rem;padding-left:1.8rem;}
	.link-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.5rem;padding:1.25rem 1.5rem;}
	.link-card{background:#fefefe;border:1px solid #e9edf2;border-radius:0.75rem;transition:all 0.15s ease;}
	.link-card:hover{background:#fafcff;border-color:#cddae3;}
	.link-card a{display:flex;align-items:center;gap:0.7rem;padding:0.65rem 1rem;text-decoration:none;font-size:0.85rem;font-weight:450;color:#1f4e6e;}
	.link-card a:hover{color:#1f6e43;}
	.link-icon{font-size:1.2rem;min-width:28px;text-align:center;opacity:0.7;}
	.link-name{flex:1;word-break:break-word;}
	.file-badge{font-family:ui-monospace,monospace;font-size:0.65rem;background:#eef2f6;padding:0.15rem 0.45rem;border-radius:20px;color:#4f6f8f;margin-left:0.5rem;white-space:nowrap;}
	.docs-footer{padding:0.75rem 1.5rem;border-top:1px solid #eef2f5;font-size:0.7rem;color:#7890a8;display:flex;justify-content:space-between;flex-wrap:wrap;}
	@media(max-width:640px){.link-grid{padding:1rem;gap:0.4rem;}.link-card a{padding:0.6rem 0.85rem;}.file-badge{white-space:normal;}}
	.qa-box{background:#f8f9fa;border-left:5px solid #0f2c2f;border-radius:16px;padding:1.5rem;margin:2rem 0 1rem;box-shadow:0 2px 8px rgba(0,0,0,0.03);}
	.qa-box h3{color:#0f2c2f;margin-top:0;}
	.qa-step-list{padding-left:1.2rem;margin:0.8rem 0;}
	.qa-step-list li{margin-bottom:0.6rem;line-height:1.4;}
</style>

